      "id": "adapter-cda-kernel",
      "version": "0.1.3",
      "source_ref_ids": [
        "cda-repo"
      ],
      "semantic_owner": "Matias Salgado",
      "adapter_author": "Matias Salgado",
      "claim": "Two-Axis Policy Envelope and Verification produced by CDA 2.0 Kernel",
      "implementation": {
        "kind": "declarative",
        "reviewed_plugin_id": null
      },
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "axis_1_verdict": {
            "type": "string",
            "enum": [
              "ALLOW",
              "REMEDIATE",
              "REQUIRES_HUMAN_REVIEW",
              "DENY",
              "INDETERMINATE"
            ]
          },
          "axis_2_evidence": {
            "type": "string",
            "enum": [
              "PAYLOAD_VALID",
              "PAYLOAD_TAMPERING_DETECTED",
              "TOCTOU_STALE_CONTEXT_DETECTED",
              "EXPIRED_LEASE_TOKEN",
              "UNMAPPED_REGIME_CONTEXT"
            ]
          },
          "fallback_action": {
            "type": "string",
            "enum": [
              "NONE",
              "BLOCK",
              "HOLD"
            ]
          }
        },
        "required": [
          "axis_1_verdict",
          "axis_2_evidence"
        ]
      },
      "field_mappings": [
        {
          "source_pointer": "/axis_1_verdict",
          "target_pointer": "/adapters/adapter-cda-kernel/decision",
          "operation": "enum_map",
          "enum_map": {
            "ALLOW": "allow",
            "REMEDIATE": "remediate",
            "REQUIRES_HUMAN_REVIEW": "review",
            "DENY": "reject",
            "INDETERMINATE": "indeterminate"
          },
          "on_missing": "indeterminate"
        }
      ],
      "semantics": {
        "meaning": "The deterministic two-axis authorization result R(I) evaluated against the frozen policy version and cryptographic PASETO v4 seal.",
        "unknown_handling": "indeterminate",
        "negative_case": "An unsealed, tampered, or expired PASETO v4 token envelope, or an unmapped operating regime (Fail-Closed).",
        "forbidden_inferences": [
          "Treating an ALLOW verdict as an executed action without atomic Gate Check-to-Act re-verification.",
          "Conflating an Axis 1 business policy rejection with an Axis 2 cryptographic signature failure."
        ]
      },
      "review": {
        "technical_verification": {
          "status": "verified",
          "reviewer": "Matias Salgado",
          "evidence_refs": [
            "https://github.com/matiascloudarch/cognitive-decision-architecture/blob/main/INTEGRITY.md"
          ]
        },
        "preparer_review": {
