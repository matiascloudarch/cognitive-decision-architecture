  "objective": {
    "question": "Can the CDA 2.0 Policy Kernel enforce two-axis cryptographic verification (PASETO v4) and prevent unauthorized actions or TOCTOU drift while gracefully handling context opacity with INDETERMINATE fail-closed responses?",
    "hypothesis": "A two-axis fail-closed Policy Kernel will enforce atomic check-to-act execution, block tampered or expired tokens, remediate parameter bounds deterministically, and default to BLOCK/HOLD on stale or unmapped regime contexts.",
    "controlled_change": "Unenforced baseline execution vs CDA 2.0 Two-Axis PASETO v4 Kernel enforcement.",
    "excluded_conclusions": [
      "Mapping fidelity alone does not establish legal compliance or multi-party regulatory enforceability.",
      "Imported synthetic fixture events do not establish live cloud production deployment verification."
    ],
    "success_metrics": [
      {
        "id": "metric-1",
        "definition": "Accuracy rate of Axis 1 action verdicts and Axis 2 evidence rejection classifications",
        "unit": "ratio",
        "denominator": "Total synthetic test vectors evaluated"
      },
      {
        "id": "metric-2",
        "definition": "Count of successfully blocked TOCTOU context drifts at the atomic check-to-act execution boundary",
        "unit": "count",
        "denominator": "Total injected execution drift attempts"
      }
    ]
  },
